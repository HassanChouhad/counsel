# ==============================================================================
# CounselCore Environment Variables Configuration
# ==============================================================================
# Rename this file to '.env' and populate your actual AWS credentials.
# Do NOT commit your actual '.env' file to public source control.
# ==============================================================================

# AWS Access Key ID (Required)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here

# AWS Secret Access Key (Required)
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS Region (Required - e.g., us-east-1, us-west-2, etc.)
AWS_DEFAULT_REGION=us-east-1

# Optional: Set a custom Bedrock Model ID
# Defaults to: anthropic.claude-3-sonnet-20240229-v1:0
# Other recommended options:
# - us.anthropic.claude-3-5-sonnet-20241022-v2:0 (Claude 3.5 Sonnet v2)
# - anthropic.claude-3-haiku-20240307-v1:0 (Claude 3 Haiku for faster, cheaper execution)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
