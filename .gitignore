# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tosca/
.pytest_cache/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.run/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_cache/

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's machine. See:
#   https://stackoverflow.com/questions/11883398/is-it-appropriate-to-commit-pyenv-local
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally have its Pipfile.lock committed,
#   by defaults. But can be ignored for library development.
#Pipfile.lock

# poetry
#   poetry.lock is usually committed.
#poetry.lock

# pdm
#   pdm.lock is usually committed.
#pdm.lock

# virtualenv
venv/
.venv/
ENV/
env/
active_env/

# IDE / Editor configuration
.idea/
.vscode/
*.swp
*.swo

# Environment variables (Sensitive files)
.env
.env.*
!.env.example

# macOS specific files
.DS_Store
